<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootGameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/boardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintDimensionRatio="1920:1080"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Board image drawn FIRST so it sits behind all overlays -->
        <ImageView
            android:id="@+id/imgBoard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/cboard"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Room overlay for dots inside rooms -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/roomOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Grid overlay for player dots on hallway cells -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gridOverlayTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.322" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gridOverlayBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.725" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gridOverlayLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.305" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gridOverlayRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.655" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/gridOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/gridOverlayTop"
            app:layout_constraintBottom_toTopOf="@id/gridOverlayBottom"
            app:layout_constraintStart_toEndOf="@id/gridOverlayLeft"
            app:layout_constraintEnd_toStartOf="@id/gridOverlayRight"/>

        <LinearLayout
            android:id="@+id/characterPanel"
            android:layout_width="80dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:padding="4dp" />
        <LinearLayout
            android:id="@+id/actionLogContainer"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@android:color/transparent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/characterPanel"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="10dp"/>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/suspectChecklistOverlayTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.126" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/suspectChecklistOverlayBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.315" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/checklistOverlayLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.774" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/checklistOverlayRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="1" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/suspectChecklistOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/suspectChecklistOverlayTop"
            app:layout_constraintBottom_toTopOf="@id/suspectChecklistOverlayBottom"
            app:layout_constraintStart_toEndOf="@id/checklistOverlayLeft"
            app:layout_constraintEnd_toStartOf="@id/checklistOverlayRight" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/weaponChecklistOverlayTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.375" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/weaponChecklistOverlayBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.613" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/weaponChecklistOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/weaponChecklistOverlayTop"
            app:layout_constraintBottom_toTopOf="@id/weaponChecklistOverlayBottom"
            app:layout_constraintStart_toEndOf="@id/checklistOverlayLeft"
            app:layout_constraintEnd_toStartOf="@id/checklistOverlayRight" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/roomChecklistOverlayTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.671" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/roomChecklistOverlayBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.955" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/roomChecklistOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/roomChecklistOverlayTop"
            app:layout_constraintBottom_toTopOf="@id/roomChecklistOverlayBottom"
            app:layout_constraintStart_toEndOf="@id/checklistOverlayLeft"
            app:layout_constraintEnd_toStartOf="@id/checklistOverlayRight" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideGridTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.21" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideGridBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.93" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideGridStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.25" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideGridEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.75" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideBtnTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.172" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideBtnBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.208" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideBtn0Start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.200" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideBtn0End"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.298" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideBtn1Start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.315" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideBtn1End"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.432" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideBtn2Start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.448" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideBtn2End"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.537" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideBtn3Start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.555" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideBtn3End"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.644" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideBtn4Start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.663" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideBtn4End"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.754" />

        <Button
            android:id="@+id/btnRollDice"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/transparent_button_bg"
            android:stateListAnimator="@null"
            android:text=""
            app:layout_constraintTop_toBottomOf="@id/guideBtnTop"
            app:layout_constraintBottom_toTopOf="@id/guideBtnBottom"
            app:layout_constraintStart_toEndOf="@id/guideBtn0Start"
            app:layout_constraintEnd_toStartOf="@id/guideBtn0End" />

        <Button
            android:id="@+id/btnHiddenWay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/transparent_button_bg"
            android:stateListAnimator="@null"
            android:text=""
            app:layout_constraintTop_toBottomOf="@id/guideBtnTop"
            app:layout_constraintBottom_toTopOf="@id/guideBtnBottom"
            app:layout_constraintStart_toEndOf="@id/guideBtn1Start"
            app:layout_constraintEnd_toStartOf="@id/guideBtn1End" />

        <Button
            android:id="@+id/btnSuggest"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/transparent_button_bg"
            android:stateListAnimator="@null"
            android:text=""
            app:layout_constraintTop_toBottomOf="@id/guideBtnTop"
            app:layout_constraintBottom_toTopOf="@id/guideBtnBottom"
            app:layout_constraintStart_toEndOf="@id/guideBtn2Start"
            app:layout_constraintEnd_toStartOf="@id/guideBtn2End" />

        <Button
            android:id="@+id/btnAccuse"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/transparent_button_bg"
            android:stateListAnimator="@null"
            android:text=""
            app:layout_constraintTop_toBottomOf="@id/guideBtnTop"
            app:layout_constraintBottom_toTopOf="@id/guideBtnBottom"
            app:layout_constraintStart_toEndOf="@id/guideBtn3Start"
            app:layout_constraintEnd_toStartOf="@id/guideBtn3End" />

        <Button
            android:id="@+id/btnLeave"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/transparent_button_bg"
            android:stateListAnimator="@null"
            android:text=""
            app:layout_constraintTop_toBottomOf="@id/guideBtnTop"
            app:layout_constraintBottom_toTopOf="@id/guideBtnBottom"
            app:layout_constraintStart_toEndOf="@id/guideBtn4Start"
            app:layout_constraintEnd_toStartOf="@id/guideBtn4End" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialogOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>